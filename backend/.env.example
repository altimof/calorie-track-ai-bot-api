# Application
APP_ENV=dev
LOG_LEVEL=INFO

# CORS: comma-separated allowed origins for the frontend. Required if you deploy your
# own fork — when unset, APP_ENV=production falls back to this repo's own Vercel domain
# (https://calorie-track-ai-bot.vercel.app), which will NOT match your frontend's URL and
# silently blocks every request from your Mini App (requests fail CORS with no obvious
# error in the backend logs). Also include https://t.me if you rely on Telegram's own
# webview origin.
# CORS_ORIGINS=https://your-frontend.vercel.app,https://t.me

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
WEBHOOK_URL=https://your-public-url/bot
USE_WEBHOOK=false

# Inline mode
INLINE_MODE_ENABLED=false
INLINE_HASH_SALT=change-me-inline-hash-salt
INLINE_THROUGHPUT_PER_MIN=60
INLINE_BURST_RPS=5

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-5-mini

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Redis
REDIS_URL=redis://localhost:6379

# Tigris/S3
AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
AWS_ACCESS_KEY_ID=tid_xxxxxx
AWS_SECRET_ACCESS_KEY=tsec_xxxxxx
BUCKET_NAME=your-bucket-name
AWS_REGION=auto

# Analytics / Monitoring
PERFORMANCE_THRESHOLD_FACTOR=1.0
HEALTH_TIME_LIMIT=200
MEMORY_THRESHOLD_MB=100
CPU_THRESHOLD_PERCENT=200

# Optional: API base URL override for Mini App previews
API_BASE_URL=http://localhost:8000
